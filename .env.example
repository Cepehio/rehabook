# Docker Compose aplinka. Nukopijuokite į .env ir įrašykite savo reikšmes.
POSTGRES_PASSWORD=local_database_password
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_EMAIL=admin@rehabook.lt
ADMIN_PASSWORD=REPLACE_WITH_YOUR_ADMIN_PASSWORD
CLIENT_ORIGIN=http://localhost:5173
MAIL_MODE=file
# Priminimai prieš vizitą (API konteineris): REMINDERS_ENABLED=true|false, REMINDER_CRON, REMINDER_TZ
REMINDERS_ENABLED=true
# Vietiniam Vite galima nepildyti: užklausos nukreipiamos per /api tarpinį serverį.
# VITE_API_URL=http://localhost:4000/api
