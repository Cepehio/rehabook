# PostgreSQL prisijungimas. Įrašyk savo postgres slaptažodį vietoj SLAPTAZODIS.
DATABASE_URL="postgresql://postgres:SLAPTAZODIS@localhost:5432/rehabook?schema=public"

# JWT pasirašymo raktas — pakeisk į ilgą atsitiktinę eilutę 
JWT_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_EXPIRES_IN="1h"

# Administratoriaus kredencialai (admin nelaikomas DB lentelėje)
ADMIN_EMAIL="admin@rehabook.lt"
ADMIN_PASSWORD="admin123"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# ─── El. paštas ───
# "file" — laiškas saugomas vietiniame outbox kataloge, išorėje nesiunčiamas.
# "smtp" — siunčiama per žemiau nurodytą SMTP (galima naudoti Ethereal testavimui).
MAIL_MODE="file"
MAIL_OUTBOX_DIR="outbox"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="RehaBook <noreply@rehabook.lt>"

# ─── Rate limiting (neprivaloma; numatyta 10 nepavykusių bandymų / 15 min) ───
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=900000

# ─── Priminimai prieš vizitą (planuoklis node-cron) ───
# Kasdien REMINDER_CRON laiku pacientams, turintiems rytojaus laukiamą/patvirtintą vizitą,
# parengiamas priminimo laiškas (vieną kartą vizitui). Rankinis paleidimas: npm run reminders
REMINDERS_ENABLED=true
REMINDER_CRON="0 9 * * *"
REMINDER_TZ="Europe/Vilnius"

# Surinktos sąsajos katalogas (numatyta – projekto šaknies dist po `npm run build`);
# nurodykite tik jei sąsaja surinkta kitur. Be dist katalogo sąsaja neaptarnaujama.
# CLIENT_DIST=../dist
